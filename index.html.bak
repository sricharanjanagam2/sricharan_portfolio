  palette.querySelectorAll(".command-list button").forEach(b=>b.style.display=b.textContent.toLowerCase().includes(q)?"block":"none");
};

/* 25 Smart portfolio search */
const projectSearch=document.getElementById("projectSearch");
projectSearch.oninput=()=>{
  const q=projectSearch.value.toLowerCase().trim();
  document.querySelectorAll(".project").forEach(p=>{
    p.style.display=!q||p.textContent.toLowerCase().includes(q)||p.dataset.category.includes(q)?"block":"none";
  });
};
document.getElementById("clearSearch").onclick=()=>{projectSearch.value="";projectSearch.dispatchEvent(new Event("input"));projectSearch.focus()};

/* 26 3D tilt cards */
document.querySelectorAll(".tilt").forEach(card=>{
  card.addEventListener("mousemove",e=>{
    const r=card.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
    card.style.transform=`perspective(700px) rotateX(${-y*7}deg) rotateY(${x*7}deg) translateY(-6px)`;
  });
  card.addEventListener("mouseleave",()=>card.style.transform="");
});

