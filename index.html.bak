<script>
/* 01 Loader */
window.addEventListener("load",()=>setTimeout(()=>document.getElementById("loader").classList.add("hide"),900));

/* 02 Cursor – simple cinematic */
(function(){
  const dot=document.getElementById("cDot");
  const ring=document.getElementById("cRing");
  if(!dot||!ring)return;
  let mx=window.innerWidth/2,my=window.innerHeight/2;
  let rx=mx,ry=my;

  document.addEventListener("mousemove",e=>{
    mx=e.clientX;my=e.clientY;
    dot.style.left=mx+"px";dot.style.top=my+"px";
  });

  (function loop(){
    rx+=(mx-rx)*.1;
    ry+=(my-ry)*.1;
    ring.style.left=rx+"px";
    ring.style.top=ry+"px";
    requestAnimationFrame(loop);
  })();

  document.querySelectorAll("a,button,.card,.project-media,.featured-section,.reel-tile").forEach(el=>{
    el.addEventListener("mouseenter",()=>ring.classList.add("hover"));
    el.addEventListener("mouseleave",()=>ring.classList.remove("hover"));
  });

  document.addEventListener("mousedown",()=>dot.classList.add("click"));
  document.addEventListener("mouseup",()=>dot.classList.remove("click"));
})();

/* 03 Mobile menu */
document.getElementById("menuBtn").onclick=()=>document.getElementById("navLinks").classList.toggle("open");
document.querySelectorAll(".nav-links a").forEach(a=>a.onclick=()=>document.getElementById("navLinks").classList.remove("open"));

/* 04 Theme saved locally */
const themeBtn=document.getElementById("themeBtn");
function applyTheme(){
  const light=localStorage.getItem("sricharan-theme")==="light";
  document.body.classList.toggle("light",light);
  themeBtn.textContent=light?"🌙":"☀";
}
themeBtn.onclick=()=>{localStorage.setItem("sricharan-theme",document.body.classList.contains("light")?"dark":"light");applyTheme()};
applyTheme();

/* 05 Typing effect */
const words=["cinematic edits","Instagram reels","YouTube videos","event films","visual stories"];
let wi=0,ci=0,del=false;
function type(){
  const el=document.getElementById("typed"),word=words[wi];
  el.textContent=del?word.slice(0,--ci):word.slice(0,++ci);
  if(!del&&ci===word.length){del=true;setTimeout(type,1100);return}
  if(del&&ci===0){del=false;wi=(wi+1)%words.length}
  setTimeout(type,del?45:75);
}
type();

/* 06 Scroll reveal */
const reveals=document.querySelectorAll(".reveal");
const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add("show")}),{threshold:.12});
reveals.forEach(e=>observer.observe(e));

/* 07 Scroll progress + top button */
window.addEventListener("scroll",()=>{
  const h=document.documentElement.scrollHeight-window.innerHeight;
  document.getElementById("progress").style.width=(scrollY/h*100)+"%";
  document.getElementById("topBtn").style.display=scrollY>600?"block":"none";
});
document.getElementById("topBtn").onclick=()=>scrollTo({top:0,behavior:"smooth"});

/* 08 Counters */
const counters=document.querySelectorAll("[data-count]");
const co=new IntersectionObserver(es=>es.forEach(e=>{
  if(!e.isIntersecting||e.target.dataset.done)return;
  e.target.dataset.done=1;const target=+e.target.dataset.count;let n=0;
  const tick=()=>{n+=Math.max(1,target/45);e.target.textContent=Math.min(Math.ceil(n),target)+"+";if(n<target)requestAnimationFrame(tick)};
  tick();
}),{threshold:.7});
counters.forEach(e=>co.observe(e));

/* 09 Skill bars */
const bars=document.querySelectorAll(".skillbar i");
const bo=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.style.width=e.target.dataset.width}),{threshold:.5});
bars.forEach(e=>bo.observe(e));

/* 10 Portfolio filters */
document.querySelectorAll(".filter").forEach(btn=>btn.onclick=()=>{
  document.querySelectorAll(".filter").forEach(b=>b.classList.remove("active"));btn.classList.add("active");
  const f=btn.dataset.filter;
  document.querySelectorAll(".project").forEach(p=>p.style.display=f==="all"||p.dataset.category===f?"block":"none");
});

/* 11 Hover video previews */
document.querySelectorAll(".project-media video").forEach(v=>{
  v.addEventListener("mouseenter",()=>v.play().catch(()=>{}));
  v.addEventListener("mouseleave",()=>{v.pause();v.currentTime=0});
});

/* Featured Work: click anywhere on section to open fullscreen */
const featuredSection=document.querySelector(".featured-section");
if(featuredSection){
  featuredSection.addEventListener("click",e=>{
    if(e.target.closest(".sound-btn")||e.target.closest(".btn"))return;
    openVideo('videos/cinematic-project.mp4');
  });
}

/* Featured sound toggle */
const featuredSoundBtn=document.getElementById("featuredSoundBtn");
const featuredVid=document.getElementById("featuredBgVideo");
if(featuredSoundBtn&&featuredVid){
  featuredSoundBtn.addEventListener("click",()=>{
    featuredVid.muted=!featuredVid.muted;
    const isMuted=featuredVid.muted;
    featuredSoundBtn.textContent=isMuted?"🔇":"🔊";
    featuredSoundBtn.setAttribute("aria-label",isMuted?"Unmute video":"Mute video");
    featuredSoundBtn.classList.toggle("muted",isMuted);
    if(!isMuted){
      featuredVid.volume=1;
      featuredVid.play().catch(()=>{});
    }
  });
}

/* Featured 02: click + sound */
const featuredSection2=document.getElementById("featuredSection2");
if(featuredSection2){
  featuredSection2.addEventListener("click",e=>{
    if(e.target.closest(".sound-btn")||e.target.closest(".btn"))return;
    openVideo('videos/instagram-reel.mp4');
  });
}
const featuredSoundBtn2=document.getElementById("featuredSoundBtn2");
const featuredVid2=document.getElementById("featuredBgVideo2");
if(featuredSoundBtn2&&featuredVid2){
  featuredSoundBtn2.addEventListener("click",()=>{
    featuredVid2.muted=!featuredVid2.muted;
    const isMuted=featuredVid2.muted;
    featuredSoundBtn2.textContent=isMuted?"🔇":"🔊";
    featuredSoundBtn2.setAttribute("aria-label",isMuted?"Unmute video":"Mute video");
    featuredSoundBtn2.classList.toggle("muted",isMuted);
    if(!isMuted){featuredVid2.volume=1;featuredVid2.play().catch(()=>{});}
  });
}

/* 12 Video modal */
function openVideo(src){
  const m=document.getElementById("modal"),v=document.getElementById("modalVideo");
  v.src=src;
  v.load();
  // Try native fullscreen on the video element directly
  const requestFS=v.requestFullscreen||v.webkitRequestFullscreen||v.mozRequestFullScreen||v.msRequestFullscreen;
  if(requestFS){
    m.classList.add("show");
    v.play().catch(()=>{});
    requestFS.call(v).catch(()=>{
      // Fullscreen denied — just show modal
    });
    // When user exits native fullscreen, close modal too
    const onFSChange=()=>{
      const fsEl=document.fullscreenElement||document.webkitFullscreenElement||document.mozFullScreenElement;
      if(!fsEl){
        v.pause();
        v.removeAttribute("src");
        v.load();
        m.classList.remove("show");
        document.removeEventListener("fullscreenchange",onFSChange);
        document.removeEventListener("webkitfullscreenchange",onFSChange);
      }
    };
    document.addEventListener("fullscreenchange",onFSChange);
    document.addEventListener("webkitfullscreenchange",onFSChange);
  } else {
    // Fallback: modal only
    m.classList.add("show");
    v.play().catch(()=>{});
  }
}
function closeVideo(){
  const m=document.getElementById("modal"),v=document.getElementById("modalVideo");
  const exitFS=document.exitFullscreen||document.webkitExitFullscreen||document.mozCancelFullScreen||document.msExitFullscreen;
  const isFS=document.fullscreenElement||document.webkitFullscreenElement||document.mozFullScreenElement;
  if(isFS&&exitFS) exitFS.call(document).catch(()=>{});
  v.pause();v.removeAttribute("src");v.load();m.classList.remove("show");
}
document.getElementById("modal").addEventListener("click",e=>{if(e.target.id==="modal")closeVideo()});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeVideo()});

/* 13 Before/after video comparison */
const compare = document.getElementById("compareSlider");
const afterWrap = document.getElementById("afterVideoWrap");
const beforeVideo = document.getElementById("beforeVideo");
const afterVideo = document.getElementById("afterVideo");
const line = document.getElementById("sliderLine");
const handle = document.getElementById("sliderHandle");
const comparePlay = document.getElementById("comparePlay");

function updateCompare(){
  const v = Number(compare.value);
  afterWrap.style.clipPath = `inset(0 0 0 ${v}%)`;
  line.style.left = v + "%";
  handle.style.left = v + "%";
}

compare.addEventListener("input", updateCompare);
updateCompare();

function syncTime(source, target){
  if (!Number.isFinite(source.currentTime)) return;
  if (Math.abs(source.currentTime - target.currentTime) > 0.08){
    try { target.currentTime = source.currentTime; } catch(e) {}
  }
}

function playBoth(){
  beforeVideo.play().catch(()=>{});
  afterVideo.play().catch(()=>{});
  comparePlay.textContent = "❚❚";
  comparePlay.setAttribute("aria-label","Pause comparison videos");
}

function pauseBoth(){
  beforeVideo.pause();
  afterVideo.pause();
  comparePlay.textContent = "▶";
  comparePlay.setAttribute("aria-label","Play comparison videos");
}

comparePlay.addEventListener("click",()=>{
  if (beforeVideo.paused || afterVideo.paused) playBoth();
  else pauseBoth();
});

/* Keep both videos playing/pausing together */
beforeVideo.addEventListener("play",()=>{
  if (afterVideo.paused) afterVideo.play().catch(()=>{});
});

afterVideo.addEventListener("play",()=>{
  if (beforeVideo.paused) beforeVideo.play().catch(()=>{});
});

beforeVideo.addEventListener("pause",()=>{
  if (!afterVideo.paused) afterVideo.pause();
});

afterVideo.addEventListener("pause",()=>{
  if (!beforeVideo.paused) beforeVideo.pause();
});

/* Keep both videos synchronized */
beforeVideo.addEventListener("timeupdate",()=>{
  syncTime(beforeVideo, afterVideo);
});

afterVideo.addEventListener("timeupdate",()=>{
  syncTime(afterVideo, beforeVideo);
});

/* Sync seeking */
let syncingSeek = false;

function seekBoth(time){
  if (syncingSeek) return;
  syncingSeek = true;
  try { beforeVideo.currentTime = time; } catch(e) {}
  try { afterVideo.currentTime = time; } catch(e) {}
  requestAnimationFrame(()=>{ syncingSeek = false; });
}

beforeVideo.addEventListener("seeking",()=>{
  if (!syncingSeek) seekBoth(beforeVideo.currentTime);
});

afterVideo.addEventListener("seeking",()=>{
  if (!syncingSeek) seekBoth(afterVideo.currentTime);
});

/* Align the starting positions once both videos are ready */
function syncInitialPosition(){
  if (beforeVideo.readyState >= 1 && afterVideo.readyState >= 1){
    const duration = Math.min(
      beforeVideo.duration || Infinity,
      afterVideo.duration || Infinity
    );
    if (Number.isFinite(duration)){
      const t = Math.min(beforeVideo.currentTime || 0, duration);
      try { beforeVideo.currentTime = t; } catch(e) {}
      try { afterVideo.currentTime = t; } catch(e) {}
    }
  }
}

beforeVideo.addEventListener("loadedmetadata", syncInitialPosition);
afterVideo.addEventListener("loadedmetadata", syncInitialPosition);

/* Automatically play while the comparison is visible */
const videoCompare = document.getElementById("videoCompare");

if ("IntersectionObserver" in window && videoCompare){
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if (entry.isIntersecting && entry.intersectionRatio >= 0.45){
        playBoth();
      } else if (!entry.isIntersecting){
        pauseBoth();
      }
    });
  }, {threshold:[0,0.45,0.75]});

  observer.observe(videoCompare);
}

/* 14 FAQ */
document.querySelectorAll(".faq button").forEach(b=>b.onclick=()=>{
  const faq=b.parentElement;faq.classList.toggle("open");b.querySelector("span").textContent=faq.classList.contains("open")?"−":"+";
});

/* 15 Copy email */
document.getElementById("copyEmail").onclick=()=>{
