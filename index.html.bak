<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#08080c">
<meta name="description" content="Sricharan — professional video editor creating cinematic videos, reels, YouTube content, event films and visual stories.">
<meta name="keywords" content="Sricharan, video editor, video editing, DaVinci Resolve, After Effects, reels, YouTube editor, cinematic editor">
<meta property="og:title" content="Sricharan | Video Editor">
<meta property="og:description" content="Turning footage into visual stories.">
<meta property="og:type" content="website">
<title>Sricharan — Video Editor</title>

<style>
:root{
  --bg:#07070a;--bg2:#0d0d12;--card:rgba(20,20,28,.72);
  --text:#fff;--muted:#a7a7b4;--line:rgba(255,255,255,.10);
  --purple:#b026ff;--pink:#ff315d;--green:#25d366;--shadow:0 25px 80px rgba(0,0,0,.35);
  --nav:rgba(7,7,10,.72);
}
body.light{
  --bg:#f5f5f7;--bg2:#fff;--card:rgba(255,255,255,.78);
  --text:#111;--muted:#60606b;--line:rgba(0,0,0,.10);--nav:rgba(245,245,247,.75);
  --shadow:0 25px 80px rgba(0,0,0,.10);
}
*{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth}
html{scroll-padding-top:85px}
body{background:var(--bg);color:var(--text);font-family:Inter,Arial,sans-serif;line-height:1.6;overflow-x:hidden;cursor:none}
a{text-decoration:none;color:inherit}
button,input,textarea{font:inherit}
button{cursor:none}
::selection{background:var(--purple);color:#fff}

/* 01 Scroll progress */
#progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--purple),var(--pink));z-index:1001}

/* 02 Loader */
.loader{position:fixed;inset:0;background:#07070a;display:grid;place-items:center;z-index:2000;transition:.7s}
.loader.hide{opacity:0;visibility:hidden}
.loader-inner{text-align:center}
.loader-logo{font-size:38px;font-weight:900;letter-spacing:-2px}
.loader-logo span{color:var(--purple)}
.loader-bar{width:220px;height:3px;background:#25252d;margin:20px auto;overflow:hidden}
.loader-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--purple),var(--pink));animation:load 1.7s forwards}
@keyframes load{to{width:100%}}

/* 03 Cursor – simple cinematic */
*{cursor:none!important}
#cDot{
  position:fixed;pointer-events:none;z-index:9999;
  width:5px;height:5px;border-radius:50%;background:#fff;
  transform:translate(-50%,-50%);
  transition:transform .1s ease;
  will-change:left,top;
}
#cRing{
  position:fixed;pointer-events:none;z-index:9998;
  width:36px;height:36px;border-radius:50%;
  border:1.5px solid rgba(255,255,255,.5);
  transform:translate(-50%,-50%);
  transition:width .3s ease,height .3s ease,border-color .3s ease,box-shadow .3s ease;
  will-change:left,top;
}
#cRing.hover{
  width:54px;height:54px;
  border-color:var(--purple);
  box-shadow:0 0 20px rgba(176,38,255,.3);
}
#cDot.click{transform:translate(-50%,-50%) scale(0.5)}
@media(max-width:650px){#cDot,#cRing{display:none}*{cursor:auto!important}}

/* 04 Background blobs */
.blob{position:fixed;width:430px;height:430px;border-radius:50%;filter:blur(150px);opacity:.13;z-index:-2;animation:float 12s ease-in-out infinite}
.blob.one{background:var(--purple);left:-220px;top:-180px}
.blob.two{background:var(--pink);right:-230px;bottom:-180px;animation-delay:-5s}
@keyframes float{50%{transform:translate(70px,40px) scale(1.1)}}

/* 05 Navigation */
nav{position:fixed;top:0;left:0;width:100%;height:76px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;background:var(--nav);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);z-index:1000}
.logo{font-size:22px;font-weight:900;letter-spacing:-1px}
.logo span{color:var(--purple)}
.nav-links{display:flex;align-items:center;gap:23px}
.nav-links a{font-size:13px;color:var(--muted);transition:.25s}
.nav-links a:hover{color:var(--text)}
.icon-btn{width:38px;height:38px;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:50%}
.menu{display:none}

/* 06 Hero */
.hero{min-height:100vh;display:flex;align-items:center;padding:130px 8% 80px;position:relative;overflow:hidden}
.hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.13;z-index:-1;filter:saturate(.7)}
.hero-overlay{position:absolute;inset:0;background:radial-gradient(circle at 20% 50%,transparent,rgba(7,7,10,.92) 70%);z-index:-1}
.hero-content{max-width:920px}
.availability{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--card);padding:7px 13px;border-radius:30px;color:var(--muted);font-size:12px;backdrop-filter:blur(10px)}
.availability i{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 14px var(--green)}
.kicker{margin-top:28px;color:var(--pink);letter-spacing:4px;font-size:12px;font-weight:800}
h1{font-size:clamp(50px,9vw,115px);line-height:.92;letter-spacing:-6px;margin:15px 0 25px}
.gradient{background:linear-gradient(90deg,var(--purple),var(--pink));color:transparent;background-clip:text;-webkit-background-clip:text}
.typing{color:var(--muted);font-size:clamp(17px,2vw,22px);min-height:34px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 21px;border-radius:30px;border:1px solid transparent;background:linear-gradient(90deg,var(--purple),var(--pink));color:#fff;font-weight:800;font-size:14px;transition:.3s}
.btn:hover{transform:translateY(-4px);box-shadow:0 15px 40px rgba(176,38,255,.24)}
.btn.ghost{background:transparent;border-color:var(--line)}
.hero-meta{display:flex;gap:28px;flex-wrap:wrap;margin-top:45px;color:var(--muted);font-size:12px}
.hero-meta strong{display:block;color:var(--text);font-size:18px}

/* 07 Marquee */
.marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:17px 0;white-space:nowrap}
.marquee-track{display:inline-block;animation:marquee 24s linear infinite;font-size:12px;font-weight:900;letter-spacing:4px;color:var(--muted)}
.marquee-track span{margin:0 25px;color:var(--purple)}
@keyframes marquee{to{transform:translateX(-50%)}}

/* sections */
section{padding:100px 8%}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:38px}
.section-title{font-size:clamp(32px,5vw,52px);line-height:1}
.section-title span{color:var(--purple)}
.subtitle{color:var(--muted);max-width:620px;margin-top:12px}
.reveal{opacity:0;transform:translateY(35px);transition:.8s}
.reveal.show{opacity:1;transform:none}

/* 08 Featured project – full-bleed cinematic section */
.featured-section{
  position:relative;
  width:100vw;
  height:100vh;
  min-height:520px;
  overflow:hidden;
  border-radius:0;
  border:none;
  box-shadow:none;
  background:#000;
  margin-left:calc(-8vw - 1px);
  margin-right:calc(-8vw - 1px);
  margin-bottom:40px;
}
/* Featured 02 sits directly in <main> — no section padding to break out of */
#featuredSection2{
  margin-left:0;
  margin-right:0;
  clip-path:polygon(0 4vw, 100% 0, 100% calc(100% - 4vw), 0 100%);
  padding: 4vw 0; /* Add padding to compensate for the cut edges */
}
.featured-section video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.featured-section-overlay{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(to top,rgba(0,0,0,.65) 0%,transparent 45%)}
.featured-section-content{position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;justify-content:flex-end;padding:52px 60px}
.featured-section-meta{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.featured-play-btn{display:none}
.featured-play-btn:hover{}
/* Clickable featured section */
.featured-section{cursor:pointer}
.featured-section-bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}
.featured-section-info{flex:1}
.eyebrow{font-size:11px;letter-spacing:3px;color:var(--pink);font-weight:900}
.featured-section-info h3{font-size:clamp(36px,5vw,72px);line-height:1;letter-spacing:-2px;margin:10px 0 14px;color:#fff}
.featured-section-info p{color:rgba(255,255,255,.72);max-width:520px;font-size:14px}
.featured-section-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.featured-section-tags .tag{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.08);backdrop-filter:blur(8px);color:rgba(255,255,255,.8);padding:6px 12px;border-radius:20px;font-size:11px}
.featured-section-actions{display:flex;flex-direction:column;align-items:flex-end;gap:10px}
/* Sound toggle button */
.sound-btn{
  position:absolute;
  top:24px;
  right:28px;
  z-index:10;
  width:46px;
  height:46px;
  border-radius:50%;
  background:rgba(0,0,0,.45);
  backdrop-filter:blur(14px);
  border:1.5px solid rgba(255,255,255,.28);
  color:#fff;
  font-size:20px;
  display:grid;
  place-items:center;
  cursor:pointer;
  transition:transform .25s,background .25s,border-color .25s,box-shadow .25s;
}
.sound-btn:hover{transform:scale(1.12);background:rgba(176,38,255,.45);border-color:var(--purple);box-shadow:0 0 30px rgba(176,38,255,.35)}
.sound-btn.muted{opacity:.7}
/* stats row */
.featured-info{border:1px solid var(--line);border-radius:25px;padding:32px;background:var(--card);backdrop-filter:blur(18px);display:flex;flex-direction:column;justify-content:center}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}
.tag{border:1px solid var(--line);padding:6px 10px;border-radius:20px;color:var(--muted);font-size:11px}

/* 09 Stats */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-top:30px}
.stat{padding:28px;border:1px solid var(--line);border-radius:18px;background:var(--card);backdrop-filter:blur(12px)}
.stat b{font-size:40px;line-height:1;background:linear-gradient(90deg,var(--purple),var(--pink));color:transparent;background-clip:text;-webkit-background-clip:text}
.stat p{color:var(--muted);font-size:12px;margin-top:7px}

/* 10 Services */
.grid4,.software,.testimonials,.faq-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:19px;padding:25px;backdrop-filter:blur(14px);transition:.35s}
.card:hover{transform:translateY(-8px);border-color:rgba(176,38,255,.7);box-shadow:var(--shadow)}
.card .icon{font-size:28px;margin-bottom:18px}
.card h3{margin-bottom:7px}.card p{font-size:13px;color:var(--muted)}

/* 11 Skills */
.skills-wrap{display:grid;grid-template-columns:1fr 1fr;gap:50px}
.skill{margin:0 0 24px}.skill-top{display:flex;justify-content:space-between;font-size:13px;margin-bottom:7px}
.skill-top span:last-child{color:var(--muted)}
.skillbar{height:7px;background:var(--bg2);border:1px solid var(--line);border-radius:10px;overflow:hidden}
.skillbar i{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--purple),var(--pink));transition:1.4s}

/* 12 Software */
.software{grid-template-columns:repeat(5,1fr)}
.software .card{text-align:center;padding:22px 10px}.software .app{font-size:28px;font-weight:900}.software small{color:var(--muted)}

/* 13 Workflow */
.workflow{display:grid;grid-template-columns:repeat(5,1fr);gap:0}
.step{position:relative;padding:25px 18px;border-top:1px solid var(--line)}
.step:not(:last-child):after{content:"→";position:absolute;right:-7px;top:17px;color:var(--purple);font-size:22px}
.step b{font-size:11px;color:var(--pink);letter-spacing:2px}.step h3{margin:8px 0}.step p{font-size:12px;color:var(--muted)}

/* 14 Before after */
.compare{position:relative;max-width:1000px;height:480px;border-radius:25px;overflow:hidden;border:1px solid var(--line);background:#222}
.compare img{position:absolute;width:100%;height:100%;object-fit:cover}
.after{clip-path:inset(0 0 0 50%)}
.slider-line{position:absolute;top:0;bottom:0;left:50%;width:3px;background:#fff;z-index:4}
.slider-handle{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;z-index:5;font-weight:900}
.compare input{position:absolute;inset:0;width:100%;height:100%;opacity:0;z-index:6;cursor:ew-resize}

/* 15 Portfolio – cinematic cards */
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.filter{padding:9px 15px;border-radius:22px;border:1px solid var(--line);background:transparent;color:var(--text);font-size:12px;font-weight:700;letter-spacing:.5px}
.filter.active,.filter:hover{background:linear-gradient(90deg,var(--purple),var(--pink));border-color:transparent;color:#fff}
.portfolio{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.project{overflow:hidden;padding:0;border-radius:0;border:none;background:#000;position:relative;aspect-ratio:16/11;transition:none}
.project:hover{transform:none;box-shadow:none;border-color:transparent}
.project-media{
  position:absolute;inset:0;
  background:#000;overflow:hidden;
}
.project-media video{
  width:100%;height:100%;object-fit:cover;
  transition:transform .7s cubic-bezier(.25,.46,.45,.94),filter .5s ease;
  filter:brightness(.85);
}
.project:hover .project-media video{
  transform:scale(1.06);
  filter:brightness(1);
}
/* Dark vignette always-on */
.project-media::after{
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(0,0,0,.85) 0%,rgba(0,0,0,.1) 50%,rgba(0,0,0,.3) 100%);
  z-index:1;
  transition:opacity .4s;
}
/* Category pill */
.proj-cat{
  position:absolute;top:14px;left:14px;z-index:4;
  font-size:9px;font-weight:900;letter-spacing:2px;
  padding:5px 10px;border-radius:20px;
  background:rgba(0,0,0,.5);backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.85);
  text-transform:uppercase;
}
/* Info panel slides up from bottom */
.proj-info{
  position:absolute;bottom:0;left:0;right:0;z-index:3;
  padding:20px 22px 22px;
  transform:translateY(30px);
  opacity:0;
  transition:transform .4s cubic-bezier(.25,.46,.45,.94),opacity .4s ease;
}
.project:hover .proj-info{transform:translateY(0);opacity:1}
.proj-info h3{
  font-size:17px;font-weight:900;color:#fff;
  margin-bottom:5px;letter-spacing:-.3px;
}
.proj-info p{font-size:11px;color:rgba(255,255,255,.65);margin-bottom:10px}
.proj-tags{display:flex;gap:5px;flex-wrap:wrap}
.proj-tags span{
  font-size:9px;font-weight:700;letter-spacing:1px;
  padding:3px 8px;border-radius:10px;
  background:rgba(255,255,255,.1);backdrop-filter:blur(6px);
  border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.75);
}
/* Centered play button */
.proj-play{
  position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%) scale(.7);
  z-index:4;
  width:62px;height:62px;border-radius:50%;
  background:rgba(255,255,255,.13);
  backdrop-filter:blur(14px);
  border:2px solid rgba(255,255,255,.4);
  color:#fff;font-size:22px;
  display:grid;place-items:center;
  opacity:0;
  transition:transform .35s cubic-bezier(.34,1.56,.64,1),opacity .3s ease;
}
.project:hover .proj-play{
  opacity:1;
  transform:translate(-50%,-50%) scale(1);
}
.proj-play:hover{
  background:rgba(176,38,255,.45);
  border-color:var(--purple);
  box-shadow:0 0 30px rgba(176,38,255,.4);
}

/* 16 Testimonials */
.testimonials{grid-template-columns:repeat(3,1fr)}
.stars{color:#ffd43b;letter-spacing:2px}.client{margin-top:18px;font-weight:800;font-size:13px}

/* 17 Short-form reel gallery */
.reel-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}
.reel-tile{
  aspect-ratio:9/16;overflow:hidden;position:relative;
  background:#0a0a0f;
}
.reel-tile video{
  width:100%;height:100%;object-fit:cover;
  transition:transform .6s cubic-bezier(.25,.46,.45,.94),filter .5s ease;
  filter:brightness(.8);
}
.reel-tile:hover video{transform:scale(1.05);filter:brightness(1)}
/* Always-on gradient */
.reel-tile::after{
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(0,0,0,.75) 0%,transparent 55%);
  z-index:1;pointer-events:none;
}
/* Hover overlay */
.reel-overlay{
  position:absolute;inset:0;z-index:3;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:10px;
  opacity:0;transition:opacity .35s ease;
}
.reel-tile:hover .reel-overlay{opacity:1}
.reel-play{
  width:52px;height:52px;border-radius:50%;
  background:rgba(255,255,255,.14);backdrop-filter:blur(12px);
  border:1.5px solid rgba(255,255,255,.4);
  color:#fff;font-size:18px;
  display:grid;place-items:center;
  transform:scale(.8);transition:transform .35s cubic-bezier(.34,1.56,.64,1),background .25s;
}
.reel-tile:hover .reel-play{transform:scale(1)}
.reel-play:hover{background:rgba(176,38,255,.45);border-color:var(--purple);box-shadow:0 0 25px rgba(176,38,255,.4)}
/* Bottom label */
.reel-label{
  position:absolute;bottom:12px;left:12px;z-index:2;
  font-size:9px;font-weight:900;letter-spacing:2px;
  color:rgba(255,255,255,.7);
  padding:4px 8px;border-radius:8px;
  background:rgba(0,0,0,.4);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.1);
}
@media(max-width:900px){.reel-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:650px){.reel-grid{grid-template-columns:repeat(2,1fr)}}

/* 18 Pricing */
.pricing{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.price-card{position:relative}.price-card.feature{border-color:var(--purple);box-shadow:0 0 50px rgba(176,38,255,.12)}
.badge{position:absolute;right:15px;top:15px;background:linear-gradient(90deg,var(--purple),var(--pink));font-size:10px;padding:5px 9px;border-radius:12px}
.price{font-size:40px;font-weight:900;margin:15px 0}.price small{font-size:12px;color:var(--muted)}
.price-list{list-style:none;color:var(--muted);font-size:13px;margin:20px 0}.price-list li{margin:9px 0}

/* 19 FAQ */
.faq-grid{grid-template-columns:1fr 1fr}.faq{border:1px solid var(--line);border-radius:15px;background:var(--card);overflow:hidden}.faq button{width:100%;text-align:left;padding:18px;border:0;background:none;color:var(--text);display:flex;justify-content:space-between;font-weight:800}.faq div{max-height:0;overflow:hidden;padding:0 18px;color:var(--muted);font-size:13px;transition:.35s}.faq.open div{max-height:150px;padding-bottom:18px}

/* 20 Contact */
.contact-box{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:stretch}
.contact-info,.form{padding:32px;border:1px solid var(--line);border-radius:22px;background:var(--card);backdrop-filter:blur(15px)}
.contact-info h3{font-size:40px;line-height:1.05;margin:12px 0}.contact-info p{color:var(--muted);max-width:500px}
.socials{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.socials a{border:1px solid var(--line);padding:9px 13px;border-radius:20px;color:var(--muted);font-size:12px}
.form{display:grid;gap:12px}.form input,.form textarea{width:100%;border:1px solid var(--line);background:var(--bg2);color:var(--text);border-radius:12px;padding:12px;outline:none}.form textarea{min-height:130px;resize:vertical}.form input:focus,.form textarea:focus{border-color:var(--purple)}
.copy{border:1px solid var(--line);background:transparent;color:var(--text);padding:8px 11px;border-radius:9px;font-size:11px;margin-left:8px}

/* 21 Footer */
footer{border-top:1px solid var(--line);padding:28px 8%;display:flex;justify-content:space-between;gap:15px;color:var(--muted);font-size:12px}
footer strong{color:var(--text)}

/* 22 Floating buttons */
.float-wa{position:fixed;right:22px;bottom:22px;width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:var(--green);color:#fff;font-size:24px;z-index:900;box-shadow:0 10px 30px rgba(0,0,0,.35)}
#topBtn{position:fixed;right:22px;bottom:88px;width:43px;height:43px;border-radius:50%;display:none;background:var(--card);border:1px solid var(--line);color:var(--text);z-index:900}

/* 23 Modal */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.98);z-index:1500;display:none;align-items:center;justify-content:center;padding:0}
.modal.show{display:flex}
.modal video{width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain}
.close{position:absolute;right:25px;top:15px;color:#fff;font-size:38px;z-index:2;background:rgba(0,0,0,.5);border-radius:50%;width:48px;height:48px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.2)}

/* 24 Toast */
.toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,30px);background:#17171e;color:#fff;border:1px solid var(--line);padding:10px 16px;border-radius:25px;opacity:0;transition:.3s;z-index:2500;font-size:12px}.toast.show{opacity:1;transform:translate(-50%,0)}


/* ===== EXTRA CREATIVE FEATURES ===== */
:root{
  --cyan:#00e5ff;--lime:#b7ff3c;--orange:#ff8a00;--blue:#5b7cff;
  --pink2:#ff4ecd;--glass:rgba(255,255,255,.045);
}
body.theme-cyan{--purple:#00e5ff;--pink:#2563ff}
body.theme-sunset{--purple:#ff8a00;--pink:#ff315d}
body.theme-green{--purple:#8cff00;--pink:#00d084}
body.theme-blue{--purple:#4f7cff;--pink:#9b5cff}
body.theme-neon{--purple:#ff00e5;--pink:#00ffe1}
body.theme-gold{--purple:#ffd166;--pink:#ff7b00}

.ambient-grid{
 position:fixed;inset:0;z-index:-3;pointer-events:none;opacity:.12;
 background-image:linear-gradient(var(--line) 1px,transparent 1px),
 linear-gradient(90deg,var(--line) 1px,transparent 1px);
 background-size:55px 55px;
 mask-image:linear-gradient(to bottom,black,transparent 75%);
}
.noise{position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:.025;
 background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
.hero-badge-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.mini-badge{padding:6px 10px;border-radius:9px;background:var(--glass);border:1px solid var(--line);font-size:10px;color:var(--muted)}
.gradient-border{position:relative}
.gradient-border:before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;background:linear-gradient(120deg,var(--purple),var(--cyan),var(--pink),var(--orange));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.magnetic{transition:transform .2s ease}
.tilt{transform-style:preserve-3d;will-change:transform}
.tilt>*{transform:translateZ(15px)}
.section-number{font-size:11px;color:var(--purple);letter-spacing:3px;font-weight:900;margin-bottom:10px}
.availability strong{color:var(--green)}
.timeline{position:relative;max-width:900px;margin:auto}
.timeline:before{content:"";position:absolute;left:18px;top:0;bottom:0;width:1px;background:var(--line)}
.timeline-item{position:relative;padding:0 0 35px 60px}
.timeline-dot{position:absolute;left:11px;top:4px;width:15px;height:15px;border-radius:50%;background:var(--purple);box-shadow:0 0 22px var(--purple)}
.timeline-item h3{margin-bottom:4px}.timeline-item p{color:var(--muted);font-size:13px}
.timeline-item small{color:var(--pink)}
.awards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.award{padding:22px;border:1px solid var(--line);border-radius:18px;background:var(--card);text-align:center}
.award b{font-size:28px;display:block}.award small{color:var(--muted)}
.color-panel{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.color-panel button{width:26px;height:26px;border-radius:50%;border:2px solid transparent;box-shadow:0 0 0 1px var(--line)}
.color-panel button.active{outline:2px solid var(--text);outline-offset:2px}
.c1{background:linear-gradient(135deg,#b026ff,#ff315d)}.c2{background:linear-gradient(135deg,#00e5ff,#2563ff)}
.c3{background:linear-gradient(135deg,#ff8a00,#ff315d)}.c4{background:linear-gradient(135deg,#8cff00,#00d084)}
.c5{background:linear-gradient(135deg,#ff00e5,#00ffe1)}.c6{background:linear-gradient(135deg,#ffd166,#ff7b00)}
.search-box{display:flex;gap:8px;margin-bottom:18px}
.search-box input{flex:1;padding:12px 15px;border:1px solid var(--line);border-radius:14px;background:var(--card);color:var(--text);outline:none}
.search-box input:focus{border-color:var(--purple)}
.command-palette{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(10px);z-index:1800;display:none;align-items:flex-start;justify-content:center;padding-top:13vh}
.command-palette.show{display:flex}
.command-box{width:min(650px,92%);background:var(--bg2);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);overflow:hidden}
.command-box input{width:100%;padding:18px;border:0;border-bottom:1px solid var(--line);outline:0;background:transparent;color:var(--text)}
.command-list button{display:block;width:100%;padding:15px 18px;text-align:left;border:0;background:transparent;color:var(--text)}
.command-list button:hover{background:var(--glass)}
.shortcuts{font-size:10px;color:var(--muted);padding:10px 18px;border-top:1px solid var(--line)}
.lang-pill{font-size:10px;border:1px solid var(--line);border-radius:15px;padding:5px 9px;color:var(--muted)}
.notice{display:none;position:fixed;left:50%;top:90px;transform:translateX(-50%);z-index:1600;padding:10px 16px;border-radius:15px;background:var(--card);border:1px solid var(--line);font-size:12px;box-shadow:var(--shadow)}
.notice.show{display:block}
.process-card{counter-increment:process}
.process-card:before{content:counter(process,decimal-leading-zero);display:block;font-size:10px;color:var(--purple);font-weight:900;margin-bottom:10px}
.process-grid{counter-reset:process}
.client-bar{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px 18px;border:1px solid var(--line);border-radius:15px;background:var(--card);margin-top:20px}
.client-bar span{color:var(--muted);font-size:12px}
.availability-pulse{animation:pulse 2s infinite}
@keyframes pulse{50%{box-shadow:0 0 0 8px rgba(37,211,102,0)}}
.scroll-hint{position:absolute;right:8%;bottom:30px;color:var(--muted);font-size:10px;letter-spacing:2px;writing-mode:vertical-rl}
.particle-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:-1}

/* Mobile */


/* ===== BEFORE / AFTER VIDEO COMPARISON ===== */
.video-compare{
  position:relative;
  overflow:hidden;
  isolation:isolate;
  background:#111;
}

.compare video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  user-select:none;
  pointer-events:none;
}

.before-video{z-index:1}

.after-video-wrap{
  position:absolute;
  inset:0;
  z-index:2;
  overflow:hidden;
  clip-path:inset(0 0 0 50%);
  will-change:clip-path;
}

.after-video{
  position:absolute !important;
  inset:0 !important;
}

.slider-line{
  position:absolute;
  top:0;
  bottom:0;
  left:50%;
  width:3px;
  background:#fff;
  z-index:5;
  transform:translateX(-50%);
  box-shadow:0 0 15px rgba(0,0,0,.45);
  pointer-events:none;
}

.slider-handle{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:50px;
  height:50px;
  border-radius:50%;
  background:#fff;
  color:#111;
  display:grid;
  place-items:center;
  z-index:7;
  font-weight:900;
  font-size:20px;
  box-shadow:0 8px 25px rgba(0,0,0,.35);
  pointer-events:none;
}

.video-compare input[type="range"]{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  opacity:0;
  z-index:8;
  cursor:ew-resize;
  margin:0;
}

.compare-label{
  position:absolute;
  top:15px;
  z-index:6;
  background:rgba(0,0,0,.55);
  color:#fff;
  padding:5px 9px;
  border-radius:10px;
  font-size:11px;
  font-weight:700;
  letter-spacing:.5px;
  pointer-events:none;
  backdrop-filter:blur(8px);
}

.before-label{left:15px}
.after-label{right:15px}

.compare-play{
  position:absolute;
  left:50%;
  bottom:16px;
  transform:translateX(-50%);
  z-index:9;
  width:46px;
  height:46px;
  border:1px solid rgba(255,255,255,.35);
  border-radius:50%;
  background:rgba(0,0,0,.58);
  backdrop-filter:blur(12px);
  color:#fff;
  font-size:16px;
  display:grid;
  place-items:center;
  cursor:pointer;
  transition:transform .2s ease,background .2s ease;
}

.compare-play:hover{
  transform:translateX(-50%) scale(1.08);
  background:rgba(0,0,0,.78);
}


/* ===== APPLE-STYLE SCROLL CONTROLLED VIDEO ===== */
.scroll-video-section{position:relative;height:260vh;margin:0;padding:0}
.scroll-video-sticky{position:sticky;top:0;height:100vh;min-height:600px;overflow:hidden;background:#050509;isolation:isolate}
.scroll-video-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;z-index:0;transform:scale(1.015);will-change:transform}
.scroll-video-overlay{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,.34) 0%,rgba(0,0,0,.05) 35%,rgba(0,0,0,.58) 100%),radial-gradient(circle at 50% 50%,transparent 20%,rgba(0,0,0,.35) 100%);pointer-events:none}
.scroll-video-content{position:absolute;left:8%;bottom:12%;z-index:3;max-width:720px;pointer-events:none;text-shadow:0 4px 30px rgba(0,0,0,.5);transition:opacity .25s ease,transform .25s ease}
.scroll-video-kicker{font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:15px;color:#fff;opacity:.9}
.scroll-video-content h2{margin:0;font-size:clamp(50px,8vw,120px);line-height:.86;letter-spacing:-6px;color:#fff}
.scroll-video-content h2 span{background:linear-gradient(90deg,var(--accent),#fff);-webkit-background-clip:text;background-clip:text;color:transparent}
.scroll-video-content p{margin:22px 0 0;color:rgba(255,255,255,.78);font-size:15px}
.scroll-video-progress{position:absolute;z-index:5;left:50%;bottom:28px;transform:translateX(-50%);width:min(320px,55vw);height:2px;background:rgba(255,255,255,.25);border-radius:99px;overflow:hidden}
.scroll-video-progress span{display:block;width:0%;height:100%;background:#fff;transform-origin:left center;will-change:width}
.scroll-video-hint{position:absolute;right:7%;bottom:26px;z-index:5;display:flex;align-items:center;gap:8px;color:#fff;opacity:.75;transition:opacity .3s ease;pointer-events:none}
.scroll-video-hint span{font-size:20px;animation:scrollHint 1.3s ease-in-out infinite}
.scroll-video-hint small{font-size:9px;letter-spacing:1.5px;font-weight:800}
@keyframes scrollHint{0%,100%{transform:translateY(-3px)}50%{transform:translateY(4px)}}
@media(max-width:650px){.scroll-video-section{height:220vh}.scroll-video-sticky{min-height:520px}.scroll-video-content{left:6%;bottom:12%;right:6%}.scroll-video-content h2{letter-spacing:-3px;font-size:clamp(45px,14vw,78px)}.scroll-video-content p{font-size:13px}.scroll-video-progress{bottom:22px}.scroll-video-hint{right:6%;bottom:45px}}

@media(max-width:900px){.awards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:650px){
  .video-compare{height:320px}
 .awards{grid-template-columns:1fr 1fr}.client-bar{display:block}.color-panel{margin-top:14px}
 .scroll-hint{display:none}.command-palette{padding-top:9vh}
}

@media(max-width:900px){
  .grid4{grid-template-columns:repeat(2,1fr)}.software{grid-template-columns:repeat(3,1fr)}
  .featured,.skills-wrap,.contact-box{grid-template-columns:1fr}.portfolio{grid-template-columns:repeat(2,1fr)}
  .stats{grid-template-columns:repeat(2,1fr)}.workflow{grid-template-columns:1fr 1fr}.reel-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:650px){
  body{cursor:auto}button{cursor:pointer}.cursor,.cursor-dot{display:none}
  nav{height:65px;padding:0 5%}.nav-links{position:absolute;top:65px;left:0;width:100%;display:none;flex-direction:column;align-items:flex-start;padding:20px 5%;background:var(--nav);border-bottom:1px solid var(--line)}.nav-links.open{display:flex}.nav-links a{font-size:14px}.menu{display:block}.theme{margin-left:auto;margin-right:8px}
  .hero{padding:115px 5% 70px}.hero-video{display:none}h1{letter-spacing:-3px;font-size:55px}.hero-meta{gap:18px}
  section{padding:75px 5%}.section-head{display:block}.grid4,.software,.portfolio,.testimonials,.pricing,.faq-grid{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr 1fr}.featured-media{min-height:300px}.compare{height:320px}.workflow{grid-template-columns:1fr}.step:not(:last-child):after{content:"↓";right:auto;left:20px;top:auto;bottom:-16px}.reel-grid{grid-template-columns:repeat(3,1fr)}
  footer{display:block;text-align:center}.footer-right{margin-top:8px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}
}

/* ===== EXTRA COLOR THEMES ===== */
body[data-theme="cyan"]{
  --purple:#00d9ff;--pink:#0066ff;--green:#21e6a8;
}
body[data-theme="orange"]{
  --purple:#ff7a00;--pink:#ff1744;--green:#26d07c;
}
body[data-theme="emerald"]{
  --purple:#00d084;--pink:#00a8a8;--green:#6cff8d;
}
body[data-theme="gold"]{
  --purple:#ffd166;--pink:#ff8c42;--green:#53e08a;
}
body[data-theme="blue"]{
  --purple:#7c5cff;--pink:#00b8ff;--green:#55efc4;
}
body[data-theme="rainbow"]{
  --purple:#ff4ecd;--pink:#6c5ce7;--green:#00d9a5;
}
body[data-theme="rainbow"] h1 .gradient,
body[data-theme="rainbow"] .gradient,
body[data-theme="rainbow"] .btn{
  background:linear-gradient(90deg,#ff4ecd,#7c5cff,#00d9ff,#00d084,#ffd166,#ff7a00);
  background-size:300% 100%;
  animation:rainbowMove 7s linear infinite;
  color:transparent;
  background-clip:text;
  -webkit-background-clip:text;
}
body[data-theme="rainbow"] .btn{color:#fff}
@keyframes rainbowMove{to{background-position:300% 0}}

/* ===== EXTRA VISUAL EFFECTS ===== */
#particleCanvas{
  position:fixed;inset:0;width:100%;height:100%;
  pointer-events:none;z-index:-1;opacity:.55;
}
.section-glow{
  position:absolute;width:280px;height:280px;border-radius:50%;
  background:var(--purple);filter:blur(130px);opacity:.08;
  pointer-events:none;
}
.card.tilt{transform-style:preserve-3d;will-change:transform}
.card.tilt:hover{transform:none}
.card.tilt > *{transform:translateZ(14px)}

.magnetic{will-change:transform}
.color-picker{
  position:fixed;right:20px;top:88px;z-index:1100;
  width:52px;height:52px;border:1px solid var(--line);
  background:var(--card);backdrop-filter:blur(18px);
  border-radius:16px;display:grid;place-items:center;
  color:var(--text);font-size:20px;box-shadow:var(--shadow);
}
.color-panel{
  position:fixed;right:20px;top:148px;z-index:1099;
  width:235px;padding:16px;border:1px solid var(--line);
  background:var(--card);backdrop-filter:blur(20px);
  border-radius:18px;box-shadow:var(--shadow);
  display:none;
}
.color-panel.open{display:block}
.color-panel h4{margin-bottom:12px}
.palette{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.palette button{
  height:42px;border:1px solid rgba(255,255,255,.15);
  border-radius:12px;color:#fff;font-size:11px;font-weight:800;
}
.p-violet{background:linear-gradient(135deg,#b026ff,#ff315d)}
.p-cyan{background:linear-gradient(135deg,#00d9ff,#0066ff)}
.p-orange{background:linear-gradient(135deg,#ff7a00,#ff1744)}
.p-emerald{background:linear-gradient(135deg,#00d084,#00a8a8)}
.p-gold{background:linear-gradient(135deg,#ffd166,#ff8c42)}
.p-blue{background:linear-gradient(135deg,#7c5cff,#00b8ff)}
.p-rainbow{background:linear-gradient(135deg,#ff4ecd,#7c5cff,#00d9ff,#00d084,#ffd166)}

.command-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.72);
  backdrop-filter:blur(12px);z-index:1900;display:none;
  align-items:flex-start;justify-content:center;padding-top:14vh;
}
.command-overlay.open{display:flex}
.command-box{
  width:min(620px,92vw);background:var(--card);
  border:1px solid var(--line);border-radius:22px;
  box-shadow:0 30px 100px rgba(0,0,0,.5);overflow:hidden;
}
.command-search{
  display:flex;align-items:center;gap:10px;padding:17px 20px;
  border-bottom:1px solid var(--line);
}
.command-search input{
  flex:1;border:0;outline:0;background:transparent;color:var(--text);
  font-size:17px;
}
.command-list{padding:8px;max-height:380px;overflow:auto}
.command-item{
  width:100%;display:flex;justify-content:space-between;align-items:center;
  padding:13px 15px;border:0;background:transparent;color:var(--text);
  border-radius:12px;text-align:left;
}
.command-item:hover,.command-item.selected{background:rgba(176,38,255,.14)}
.command-item small{color:var(--muted)}

.service-modal{
  position:fixed;inset:0;display:none;align-items:center;justify-content:center;
  background:rgba(0,0,0,.82);backdrop-filter:blur(12px);z-index:1700;padding:20px;
}
.service-modal.open{display:flex}
.service-box{
  width:min(650px,94vw);padding:32px;border:1px solid var(--line);
  border-radius:25px;background:var(--card);box-shadow:var(--shadow);
}
.service-close{float:right;background:transparent;border:0;color:var(--muted);font-size:30px}
.service-box ul{margin:20px 0 25px;padding-left:20px;color:var(--muted)}
.service-box li{margin:8px 0}

.reading-badge{
  display:inline-flex;margin-top:10px;padding:6px 10px;border-radius:20px;
  border:1px solid var(--line);color:var(--muted);font-size:11px;
}

@media(max-width:650px){
  .color-picker{right:12px;top:76px}
  .color-panel{right:12px;top:136px}
  .command-overlay{padding-top:9vh}
}

</style>
</head>

<body>
<div class="ambient-grid"></div><div class="noise"></div>
<div id="progress"></div>

<div class="loader" id="loader">
  <div class="loader-inner">
    <div class="loader-logo">S<span>.</span></div>
    <div class="loader-bar"><i></i></div>
    <small style="color:#888">LOADING SHOWREEL...</small>
  </div>
</div>

<div id="cDot"></div>
<div id="cRing"></div>
<div class="blob one"></div><div class="blob two"></div>

<nav>
  <a href="#home" class="logo">Sricharan<span>.</span></a>
  <div class="nav-links" id="navLinks">
    <a href="#work">Work</a><a href="#about">About</a><a href="#services">Services</a>
    <a href="#skills">Skills</a><a href="#contact">Contact</a>
  </div>
  <div style="display:flex;align-items:center">
    <button class="icon-btn" id="shareBtn" aria-label="Share portfolio">↗</button>
    <button class="icon-btn theme" id="themeBtn" aria-label="Toggle theme">☀</button>
    <button class="icon-btn menu" id="menuBtn" aria-label="Open menu">☰</button>
  </div>
</nav>


<!-- ===== EXTRA UI ===== -->
<canvas id="particleCanvas"></canvas>

<div class="color-panel" id="colorPanel">
  <h4>Choose a color</h4>
  <div class="palette">
    <button class="p-violet" data-theme="violet">Violet</button>
    <button class="p-cyan" data-theme="cyan">Cyan</button>
    <button class="p-orange" data-theme="orange">Orange</button>
    <button class="p-emerald" data-theme="emerald">Emerald</button>
    <button class="p-gold" data-theme="gold">Gold</button>
    <button class="p-blue" data-theme="blue">Blue</button>
    <button class="p-rainbow" data-theme="rainbow">Rainbow</button>
  </div>
</div>

<div class="command-overlay" id="commandOverlay">
  <div class="command-box">
    <div class="command-search">
      <span>⌘K</span>
      <input id="commandInput" placeholder="Search sections, actions..." autocomplete="off">
      <span style="color:var(--muted)">ESC</span>
    </div>
    <div class="command-list" id="commandList">
      <button class="command-item" data-command="home"><span>🏠 Go to Home</span><small>Home</small></button>
      <button class="command-item" data-command="work"><span>🎬 View Portfolio</span><small>Work</small></button>
      <button class="command-item" data-command="services"><span>⚡ View Services</span><small>Services</small></button>
      <button class="command-item" data-command="contact"><span>📩 Contact Sricharan</span><small>Contact</small></button>
      <button class="command-item" data-command="theme"><span>🎨 Change Color Theme</span><small>Theme</small></button>
      <button class="command-item" data-command="top"><span>⬆️ Back to Top</span><small>Top</small></button>
    </div>
  </div>
</div>

<div class="service-modal" id="serviceModal">
  <div class="service-box">
    <button class="service-close" id="serviceClose">×</button>
    <div class="eyebrow">SERVICE DETAILS</div>
    <h2 id="serviceTitle" class="section-title" style="margin-top:10px"></h2>
    <p id="serviceDescription" class="subtitle"></p>
    <ul id="serviceList"></ul>
    <a class="btn" href="#contact" id="serviceContact">Request This Service ↗</a>
  </div>
</div>

<main>
<header class="hero" id="home">
  <!-- Optional background video: videos/showreel.mp4 -->
  <video class="hero-video" autoplay muted loop playsinline>
    <source src="videos/showreel.mp4" type="video/mp4">
  </video>
