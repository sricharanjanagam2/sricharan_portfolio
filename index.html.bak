  const body=encodeURIComponent(`Name: ${name}\nEmail: ${email}\nProject: ${type}\n\n${msg}`);
  location.href=`mailto:sricharanjanagam2@gmail.com?subject=${subject}&body=${body}`;
};

/* 17 Local visitor counter */
let visits=+(localStorage.getItem("sricharan-visits")||0)+1;
localStorage.setItem("sricharan-visits",visits);
document.getElementById("visits").textContent=visits;

/* 18 Local clock */
function clock(){
  document.getElementById("clock").textContent=new Intl.DateTimeFormat("en-IN",{hour:"2-digit",minute:"2-digit",second:"2-digit"}).format(new Date());
}
clock();setInterval(clock,1000);

/* 19 Toast */
let toastTimer;
function showToast(text){
  const t=document.getElementById("toast");t.textContent=text;t.classList.add("show");
  clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove("show"),1800);
}

/* 20 Keyboard shortcut: H = home, W = work, C = contact */
document.addEventListener("keydown",e=>{
  if(["INPUT","TEXTAREA"].includes(document.activeElement.tagName))return;
  if(e.key.toLowerCase()==="h")location.hash="home";
  if(e.key.toLowerCase()==="w")location.hash="portfolio";
  if(e.key.toLowerCase()==="c")location.hash="contact";
});

/* 21 Persistent accent themes */
const themeNames=["default","cyan","sunset","green","neon","gold"];
const savedAccent=localStorage.getItem("sricharan-accent")||"default";
document.body.classList.remove(...themeNames.filter(x=>x!=="default").map(x=>"theme-"+x));
if(savedAccent!=="default")document.body.classList.add("theme-"+savedAccent);
document.querySelectorAll(".color-panel button").forEach(b=>{
  b.classList.toggle("active",b.dataset.theme===savedAccent);
  b.onclick=()=>{
    themeNames.filter(x=>x!=="default").forEach(x=>document.body.classList.remove("theme-"+x));
    if(b.dataset.theme!=="default")document.body.classList.add("theme-"+b.dataset.theme);
    localStorage.setItem("sricharan-accent",b.dataset.theme);
    document.querySelectorAll(".color-panel button").forEach(x=>x.classList.remove("active"));b.classList.add("active");
    showToast("Color theme changed");
  };
});

/* 22 Share API + clipboard fallback */
document.getElementById("shareBtn").onclick=async()=>{
  const data={title:"Sricharan — Video Editor",text:"Check out my video editing portfolio.",url:location.href};
  try{
    if(navigator.share)await navigator.share(data);
    else{await navigator.clipboard.writeText(location.href);showToast("Portfolio link copied!")}
  }catch(e){}
