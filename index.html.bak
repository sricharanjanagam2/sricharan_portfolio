document.addEventListener("click",e=>{
  if(!colorPanel.contains(e.target)&&!colorPicker.contains(e.target)) colorPanel.classList.remove("open");
});

/* 22 Particle background */
const canvas=document.getElementById("particleCanvas");
const ctx=canvas.getContext("2d");
let particles=[];
function resizeParticles(){
  canvas.width=innerWidth*devicePixelRatio;
  canvas.height=innerHeight*devicePixelRatio;
  canvas.style.width=innerWidth+"px";
  canvas.style.height=innerHeight+"px";
  ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
}
function initParticles(){
  particles=Array.from({length:Math.min(75,Math.floor(innerWidth/16))},()=>({
    x:Math.random()*innerWidth,y:Math.random()*innerHeight,
    r:Math.random()*1.7+.4,dx:(Math.random()-.5)*.25,dy:(Math.random()-.5)*.25
  }));
}
function drawParticles(){
  ctx.clearRect(0,0,innerWidth,innerHeight);
  const root=getComputedStyle(document.body);
  const accent=root.getPropertyValue("--purple").trim()||"#b026ff";
  particles.forEach((p,i)=>{
    p.x+=p.dx;p.y+=p.dy;
    if(p.x<0||p.x>innerWidth)p.dx*=-1;
    if(p.y<0||p.y>innerHeight)p.dy*=-1;
    ctx.globalAlpha=.45;
    ctx.fillStyle=accent;
    ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();
    for(let j=i+1;j<particles.length;j++){
      const q=particles[j],d=Math.hypot(p.x-q.x,p.y-q.y);
      if(d<105){
        ctx.globalAlpha=(1-d/105)*.09;
        ctx.strokeStyle=accent;ctx.lineWidth=.6;
        ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.stroke();
      }
    }
  });
  requestAnimationFrame(drawParticles);
}
if(!matchMedia("(prefers-reduced-motion: reduce)").matches){
  resizeParticles();initParticles();drawParticles();
  addEventListener("resize",()=>{resizeParticles();initParticles()});
}

/* 23 3D tilt effect on cards */
if(!matchMedia("(prefers-reduced-motion: reduce)").matches){
  document.querySelectorAll(".card").forEach(card=>{
    card.classList.add("tilt");
    card.addEventListener("mousemove",e=>{
      const r=card.getBoundingClientRect();
      const x=(e.clientX-r.left)/r.width-.5;
      const y=(e.clientY-r.top)/r.height-.5;
      card.style.transform=`perspective(900px) rotateX(${(-y*5).toFixed(2)}deg) rotateY(${(x*6).toFixed(2)}deg) translateY(-5px)`;
    });
    card.addEventListener("mouseleave",()=>card.style.transform="");
  });
}

/* 24 Magnetic buttons */
if(!matchMedia("(prefers-reduced-motion: reduce)").matches){
  document.querySelectorAll(".btn").forEach(btn=>{
    btn.classList.add("magnetic");
    btn.addEventListener("mousemove",e=>{
      const r=btn.getBoundingClientRect();
      const x=(e.clientX-(r.left+r.width/2))*.12;
      const y=(e.clientY-(r.top+r.height/2))*.12;
      btn.style.transform=`translate(${x}px,${y}px)`;
    });
    btn.addEventListener("mouseleave",()=>btn.style.transform="");
  });
}

/* 25 Service detail modals */
const serviceData={
  "Cinematic Films":{
    desc:"Premium story-first editing for cinematic projects, personal films and visual campaigns.",
    list:["Story structure and pacing","Advanced color grading","Cinematic sound design","Speed ramps and transitions","4K delivery"]
  },
  "Reels & Shorts":{
    desc:"High-retention vertical content designed around hooks, rhythm and social-media viewing habits.",
    list:["9:16 vertical edit","Captions and kinetic text","Beat-synced cuts","Motion graphics","Social-ready export"]
  },
  "YouTube":{
    desc:"Long-form editing that keeps the viewer engaged without making the video feel over-edited.",
    list:["Clean storytelling cuts","B-roll and graphics","Captions","Music and sound effects","Thumbnail-ready frame selection"]
  },
  "Events":{
    desc:"Memorable highlight films for college events, birthdays, weddings and celebrations.",
    list:["Best-moment selection","Music synchronization","Highlight storytelling","Color correction","High-quality final export"]
  },
  "Music Videos":{
    desc:"Creative music edits that match visual rhythm to the track.",
    list:["Beat synchronization","Performance cuts","Creative transitions","Visual effects","Color styling"]
  },
  "Commercials":{
    desc:"Polished promotional edits for brands, creators and events.",
    list:["Product-focused storytelling","Motion graphics","Clean sound mix","Color finishing","Multiple aspect ratios"]
  },
  "Color Grading":{
    desc:"Professional color correction and creative grading to give footage a consistent visual identity.",
    list:["Exposure and white-balance correction","Skin-tone balancing","Cinematic look development","Shot matching","Final color pass"]
  },
  "Sound Design":{
    desc:"Sound that makes the edit feel alive and cinematic.",
    list:["Dialogue cleanup","Music selection","SFX layering","Ambience","Final mix and loudness check"]
  }
};
const serviceModal=document.getElementById("serviceModal");
document.querySelectorAll("#services .card").forEach(card=>{
  card.addEventListener("dblclick",()=>{
    const title=card.querySelector("h3").textContent;
    const data=serviceData[title]; if(!data)return;
    document.getElementById("serviceTitle").textContent=title;
    document.getElementById("serviceDescription").textContent=data.desc;
    document.getElementById("serviceList").innerHTML=data.list.map(x=>`<li>✓ ${x}</li>`).join("");
    serviceModal.classList.add("open");
  });
});
document.getElementById("serviceClose").onclick=()=>serviceModal.classList.remove("open");
serviceModal.addEventListener("click",e=>{if(e.target===serviceModal)serviceModal.classList.remove("open")});

/* 26 Command palette: Cmd/Ctrl + K */
const commandOverlay=document.getElementById("commandOverlay");
const commandInput=document.getElementById("commandInput");
function openCommand(){
  commandOverlay.classList.add("open");
  commandInput.value="";
  commandInput.focus();
}
function closeCommand(){commandOverlay.classList.remove("open")}
document.addEventListener("keydown",e=>{
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==="k"){
    e.preventDefault();openCommand();
  }
  if(e.key==="Escape"){closeCommand();serviceModal.classList.remove("open")}
});
document.querySelectorAll(".command-item").forEach(item=>{
  item.onclick=()=>{
    const c=item.dataset.command;
    closeCommand();
    if(c==="home") location.hash="home";
    if(c==="work") location.hash="portfolio";
    if(c==="services") location.hash="services";
    if(c==="contact") location.hash="contact";
    if(c==="top") scrollTo({top:0,behavior:"smooth"});
    if(c==="theme"){colorPanel.classList.add("open");showToast("Choose a color theme")}
  };
});
commandInput.addEventListener("input",()=>{
  const q=commandInput.value.toLowerCase();
  document.querySelectorAll(".command-item").forEach(i=>{
    i.style.display=i.textContent.toLowerCase().includes(q)?"flex":"none";
  });
});
commandOverlay.addEventListener("click",e=>{if(e.target===commandOverlay)closeCommand()});

/* 27 Section keyboard shortcut help */
document.addEventListener("keydown",e=>{
  if(e.key==="?"&&!["INPUT","TEXTAREA"].includes(document.activeElement.tagName)){
    showToast("Shortcut: ⌘/Ctrl+K opens the command palette");
  }
});

/* 28 Better portfolio video controls on click */
document.querySelectorAll(".project-media").forEach(media=>{
  media.addEventListener("click",e=>{
    if(e.target.closest("button"))return;
    const v=media.querySelector("video");
    if(v){
      if(v.paused)v.play().catch(()=>{});
      else v.pause();
    }
  });
});


/* Scroll-controlled background video */
const scrollVideoSection=document.getElementById("scrollVideoSection");
const scrollVideo=document.getElementById("scrollVideo");
const scrollVideoProgress=document.getElementById("scrollVideoProgress");
const scrollVideoHint=document.getElementById("scrollVideoHint");
const scrollVideoContent=document.querySelector(".scroll-video-content");
let scrollVideoReady=false,scrollTargetTime=0,scrollCurrentTime=0,scrollRaf=0;
scrollVideo.addEventListener("loadedmetadata",()=>{scrollVideoReady=Number.isFinite(scrollVideo.duration)&&scrollVideo.duration>0;if(scrollVideoReady){scrollVideo.pause();scrollVideo.currentTime=0}});
function updateScrollVideo(){if(!scrollVideoSection||!scrollVideoReady)return;const rect=scrollVideoSection.getBoundingClientRect();const scrollable=Math.max(1,scrollVideoSection.offsetHeight-window.innerHeight);const passed=Math.min(scrollable,Math.max(0,-rect.top));const progress=Math.min(1,Math.max(0,passed/scrollable));scrollTargetTime=progress*scrollVideo.duration;scrollCurrentTime+=(scrollTargetTime-scrollCurrentTime)*.18;if(Math.abs(scrollVideo.currentTime-scrollCurrentTime)>.012){try{scrollVideo.currentTime=scrollCurrentTime}catch(e){}}if(scrollVideoProgress)scrollVideoProgress.style.width=(progress*100)+"%";if(scrollVideoHint)scrollVideoHint.style.opacity=progress>.08?"0":".75";if(scrollVideoContent){const fade=Math.min(1,Math.max(0,(progress-.62)/.2));scrollVideoContent.style.opacity=String(1-fade);scrollVideoContent.style.transform=`translateY(${fade*-18}px)`}scrollRaf=requestAnimationFrame(updateScrollVideo)}
window.addEventListener("scroll",()=>{if(!scrollRaf)scrollRaf=requestAnimationFrame(updateScrollVideo)},{passive:true});
window.addEventListener("resize",()=>{if(!scrollRaf)scrollRaf=requestAnimationFrame(updateScrollVideo)});
updateScrollVideo();

/* 29 Pause background videos when tab is hidden */
document.addEventListener("visibilitychange",()=>{
  document.querySelectorAll("video[autoplay]").forEach(v=>{
    if(document.hidden)v.pause();
    else v.play().catch(()=>{});
  });
});

/* 30 Smooth hash navigation */
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener("click",()=>{
    const target=document.querySelector(a.getAttribute("href"));
    if(target) target.scrollIntoView({behavior:"smooth",block:"start"});
  });
});

</script>

<div class="command-palette" id="commandPalette">
  <div class="command-box">
    <input id="commandInput" placeholder="Type a command..." autocomplete="off">
    <div class="command-list">
      <button data-go="home">⌂  Home</button>
      <button data-go="work">🎬  Featured Work</button>
      <button data-go="portfolio">▦  Portfolio</button>
      <button data-go="services">✦  Services</button>
      <button data-go="contact">✉  Contact</button>
    </div>
    <div class="shortcuts">ESC close · ⌘/Ctrl + K open</div>
  </div>
</div>
<div class="notice" id="notice"></div>

</body>
</html>
