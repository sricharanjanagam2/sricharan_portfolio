/* ===== EXTRA FEATURES ===== */

/* 21 Persistent color themes */
const colorPicker=document.getElementById("colorPicker");
const colorPanel=document.getElementById("colorPanel");
const savedTheme=localStorage.getItem("sricharan-color-theme");
if(savedTheme && savedTheme!=="violet") document.body.dataset.theme=savedTheme;
colorPicker.onclick=()=>colorPanel.classList.toggle("open");
document.querySelectorAll(".palette button").forEach(btn=>{
  btn.onclick=()=>{
    const theme=btn.dataset.theme;
