/* 23 Command palette */
const palette=document.getElementById("commandPalette"),cmdInput=document.getElementById("commandInput");
function openPalette(){palette.classList.add("show");cmdInput.value="";setTimeout(()=>cmdInput.focus(),50)}
function closePalette(){palette.classList.remove("show")}
document.addEventListener("keydown",e=>{
  if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==="k"){e.preventDefault();openPalette()}
  if(e.key==="Escape")closePalette();
